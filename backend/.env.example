# DevFlow Environment Configuration Template
# Duplicate this file as '.env' in the backend directory and configure your actual values.
# NEVER commit your actual '.env' file to version control.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# MONGODB DATABASE CONFIGURATION
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<encoded_password>@cluster0.xxxxx.mongodb.net/devflow?retryWrites=true&w=majority&appName=DevFlow

# ==============================================================================
# AUTHENTICATION & JWT SECURITY
# ==============================================================================
ACCESS_TOKEN_SECRET=your_jwt_super_secret_key_minimum_32_characters_long_for_devflow
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters_long_for_devflow
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=your_jwt_refresh_super_secret_key_minimum_32_characters_long_for_devflow
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_minimum_32_characters_long_for_devflow
JWT_REFRESH_EXPIRES_IN=7d

# Cookie expiration in days
COOKIE_EXPIRES_IN=7
